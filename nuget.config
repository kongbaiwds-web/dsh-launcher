<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 沙箱内无法做在线签名校验，接受模式以允许离线恢复 -->
    <add key="signatureValidationMode" value="accept" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="E:\deepseek\work\.nuget-local" />
  </packageSources>
</configuration>
