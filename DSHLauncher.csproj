<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DSHLauncher</AssemblyName>
    <RootNamespace>DSHLauncher</RootNamespace>
      <AssemblyName>DSHLauncher</AssemblyName>
      <RootNamespace>DSHLauncher</RootNamespace>
      <AssemblyTitle>DeepSeek Harness启动器</AssemblyTitle>
      <Product>DeepSeek Harness启动器</Product>
    <Version>1.5.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>DSHLauncher.ico</ApplicationIcon>
    <!-- 只保留英文资源，去掉 WebView2 附带的多语言卫星程序集，保持输出精简 -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- Installer 是独立的子项目，不要被本项目的默认通配符编译进来 -->
  <ItemGroup>
    <Compile Remove="Installer\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
  </ItemGroup>

</Project>
